# =================================================================
# Step 6: Dockerfile — "이 서버를 돌리는 환경을 만드는 레시피"
#
# 이미지(image)    = 레시피대로 만든 완성품 (Python + 패키지 + 코드가 다 들어 있는 상자)
# 컨테이너(container) = 그 이미지를 실제로 실행한 것 (상자를 열어서 돌리는 중인 상태)
#   비유: 이미지 = 붕어빵 틀로 찍어 낸 설계, 컨테이너 = 실제 붕어빵 (하나의 이미지로 여러 개 실행 가능)
#
# 빌드:  docker build -t docs-agent .
# 실행:  README 아래쪽 / 과제 설명 참고
# =================================================================

# 1) 시작점: Python 3.11이 설치된 가벼운 Linux(Debian) 이미지
#    → conda 환경을 만들던 일을 이 한 줄이 대신한다
FROM python:3.11-slim

# 2) 컨테이너 안에서 작업할 폴더 (없으면 만들고 cd 한다)
WORKDIR /app

# 3) 패키지 설치
#    requirements.txt만 먼저 복사해서 설치하는 이유:
#    Docker는 각 줄의 결과를 캐시해 둔다. 코드만 바꾸고 다시 빌드하면 이 단계는 캐시를 써서 몇 초 만에 끝난다.
#    (코드를 먼저 복사하면 코드 한 줄만 바꿔도 패키지 설치를 매번 처음부터 다시 한다)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4) 코드 복사 (.dockerignore에 적힌 파일 — .env, *.db 등 — 은 제외된다)
COPY . .

# 5) DB 파일 위치: 컨테이너 밖과 연결할 /data 폴더 (실행할 때 -v 옵션으로 연결)
ENV DB_PATH=/data/chat.db

# 6) 이 컨테이너는 8000번 포트를 쓴다는 "표시" (실제 연결은 실행할 때 -p 옵션으로)
EXPOSE 8000

# 7) 컨테이너가 시작될 때 실행할 명령
#    --host 0.0.0.0 이 중요하다! 기본값(127.0.0.1)은 "컨테이너 자기 자신만" 접속 가능하다는 뜻이라
#    컨테이너 밖(우리 서버)에서 접속이 안 된다. 0.0.0.0 = "어디서 오든 받아라"
CMD ["uvicorn", "step5_api:app", "--host", "0.0.0.0", "--port", "8000"]
